@baseUrl   = http://localhost:3000
@adminUser = (placeholder, editable)
@adminPass = (placeholder, editable)


# @name login
POST {{baseUrl}}/api/admin/login
Content-Type: application/json

{
  "usuario": "{{adminUser}}",
  "password": "{{adminPass}}"
}


### Health check — esperado 200 { ok: true, db: 'up' }
GET {{baseUrl}}/api/health


### ============================================================
### CASO 1 — Cliente A (presupuesto simpleeee)
### ============================================================
### Esperado: 201
###   data.numero_presupuesto = "PR-XXXX"
###   data.estado             = "borrador"
###   data.total_general      = 11800
###   data.bloques.length     = 1
###   data.bloques[0].tipo    = "apartado_cerrado"
###   data.bloques[0].subtotal = 11800
# @name caso1Create
POST {{baseUrl}}/api/presupuestos
Content-Type: application/json

{
  "cliente_nombre": "Sra. Cándida López",
  "cliente_telefono": "5551234567",
  "cliente_direccion": "Nicolás San Juan 123, Col. Del Valle, Benito Juárez, CDMX",
  "ciudad": "CDMX",
  "introduccion": "A continuación se presenta el presupuesto para la instalación de tubería conduit.",
  "vigencia_dias": 7,
  "adelanto_porcentaje": 50,
  "moneda": "MXN",
  "bloques": [
    {
      "tipo": "apartado_cerrado",
      "titulo": "Instalación de tubería conduit",
      "contenido_texto": "Suministro y colocación de tubería conduit galvanizada de 3/4\" en tramo aproximado de 12 metros, incluyendo cajas de registro, conexiones y mano de obra especializada. Trabajo a ejecutarse en una jornada laboral.",
      "subtotal": 11800
    }
  ]
}


### Captura del id (para los requests siguientes)
@caso1Id = {{caso1Create.response.body.data.id}}


### CASO 1 — GET por id (verificar shape completo)
GET {{baseUrl}}/api/presupuestos/{{caso1Id}}


### ============================================================
### CASO 2 — Cliente B (multi-sección)
### ============================================================
### Esperado: 201
###   total_general = 1500 + 2200 + (2*800=1600) + 950   (Sección 1, sin opcional)
###                 + 1800 + 950                          (Sección 2)
###                 = 9000
###   bloques.length = 5
