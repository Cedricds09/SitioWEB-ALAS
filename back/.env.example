# ALAS backend — plantilla de variables de entorno.
# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA commitees `.env` (está en .gitignore). Sí se versiona `.env.example`.

# ----- Entorno -----
NODE_ENV=development
PORT=3000

# ----- Base de datos (SQL Server) -----
DB_USER=
DB_PASSWORD=
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=alas

# ----- Sesión -----
# Mínimo 32 caracteres. Generar con: openssl rand -base64 32
SESSION_SECRET=

# ----- CORS (solo producción) -----
# Origen(es) permitido(s). Acepta CSV para múltiples subdominios:
#   https://alas.com.mx,https://www.alas.com.mx,https://admin.alas.com.mx
# Vacío en producción = se rechazan todos los cross-origin.
ALLOWED_ORIGIN=

# ----- Google Maps -----
# Restringe la key por dominio en GCP antes de exponerla.
GOOGLE_MAPS_API_KEY=

# ----- Anthropic (módulo IA, Fase 3) -----
# Debe iniciar con sk-ant- (formato validado al arrancar).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ----- Modo mantenimiento -----
# true  -> el server responde 503 + mantenimiento.html en TODAS las rutas
#          excepto GET /api/health (para que UptimeRobot siga sondeando).
# false -> operación normal.
# Cambiar este valor requiere REINICIAR el server (se lee al arrancar).
MAINTENANCE_MODE=false
